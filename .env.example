# Copy to .env.local and fill in. Never commit the filled file - .gitignore
# already excludes .env* and admits only this example.

# The public origin the site is served from. lib/site.ts defaults to
# https://murphi.ai when this is unset, so a production build always emits
# canonical, sitemap, robots.txt, llms.txt, Open Graph and Twitter URLs on the
# production domain - never a development one. Set it only to point a different
# deployment (a staging host, say) somewhere else.
NEXT_PUBLIC_SITE_URL=https://murphi.ai

# The contact form needs no key. app/api/contact/route.ts forwards submissions
# to the OpsWyse Forms API, whose submit endpoint is unauthenticated and whose
# form id is public by design - where submissions land is configured on the form
# in OpsWyse, not here.
